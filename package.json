{
  "name": "open-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first intelligent writing and multi-platform publishing workspace",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "pnpm --filter @open-publisher/desktop dev",
    "dev:web": "pnpm --filter @open-publisher/desktop dev:web",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "runtime:build": "node scripts/build_pi_runtime.mjs",
    "desktop:bundle:preflight": "pnpm --filter @open-publisher/desktop bundle:preflight",
    "quality": "node scripts/quality_check.mjs"
  }
}
