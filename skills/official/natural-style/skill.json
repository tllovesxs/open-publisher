{
  "schemaVersion": "1.0",
  "id": "official.natural-style",
  "name": "Natural Style",
  "version": "1.0.0",
  "description": "改善中文文章的自然度、节奏与具体性，同时保留事实和作者意图。",
  "license": "AGPL-3.0-only",
  "runtime": {
    "kind": "declarative",
    "apiVersion": "1.0"
  },
  "capabilities": [
    "style.naturalize",
    "style.review"
  ],
  "inputArtifactTypes": [
    "article_revision_candidate",
    "style_brief"
  ],
  "outputArtifactTypes": [
    "article_revision_candidate",
    "style_review"
  ],
  "permissions": {
    "modelAccess": true,
    "imageGeneration": false,
    "browserRead": false,
    "platformWrites": false,
    "filesystem": "none",
    "networkServices": []
  },
  "declaration": {
    "objective": "减少空话、套话和机械重复，让表达更像真实作者，同时提供可审阅的修改说明。",
    "instructions": [
      "找出模板化开头、过度分点、重复总结、抽象形容词和缺乏主体的句子。",
      "优先用具体动作、对象与因果关系重写，并保持段落节奏有变化。",
      "输出修改后的候选稿和逐项 style_review。"
    ],
    "guardrails": [
      "不得改变可核实事实、数字、引用、链接和结论强度。",
      "不承诺或声称能够规避 AI 检测；目标仅是提升真实可读性。",
      "保留作者明确要求的个人风格，不把所有文本统一成一种口吻。"
    ]
  },
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rewriteStrength": {
        "enum": [
          "light",
          "balanced",
          "strong"
        ],
        "default": "balanced"
      },
      "preserveTerms": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "source": {
    "kind": "first-party"
  }
}
