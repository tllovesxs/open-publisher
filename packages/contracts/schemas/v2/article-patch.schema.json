{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openpublisher.dev/v2/article-patch.schema.json",
  "title": "ArticlePatchV2",
  "$defs": {
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionId", "expectedText", "replacementText"],
      "properties": {
        "selectionId": { "$ref": "https://schemas.openpublisher.dev/v2/common.schema.json#/$defs/Identifier" },
        "expectedText": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "replacementText": { "type": "string", "maxLength": 200000 }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "articleId", "baseRevisionId", "baseContentHash", "operations", "reason"],
      "properties": {
        "schemaVersion": { "$ref": "https://schemas.openpublisher.dev/v2/common.schema.json#/$defs/SchemaVersion" },
        "articleId": { "$ref": "https://schemas.openpublisher.dev/v2/common.schema.json#/$defs/Identifier" },
        "baseRevisionId": { "$ref": "https://schemas.openpublisher.dev/v2/common.schema.json#/$defs/Identifier" },
        "baseContentHash": { "$ref": "https://schemas.openpublisher.dev/v2/common.schema.json#/$defs/Sha256" },
        "operations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/Operation" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
