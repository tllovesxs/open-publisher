{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openpublisher.dev/v1/sidecar-protocol.schema.json",
  "title": "SidecarProtocol",
  "description": "Canonical snake_case contracts exposed by the authenticated Python Sidecar. The Rust desktop consumes the granular article, workflow, publishing, image, and connection subset; the complete demo contract remains covered for development compatibility. Requests are closed. Response projections allow documented server fields that Rust intentionally ignores, except for secret-sensitive connection profiles.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "NullableModelName": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "database",
        "publisher_mode"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "database": {
          "const": "ok"
        },
        "publisher_mode": {
          "const": "dry_run"
        }
      }
    },
    "CreateArticleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "markdown",
        "metadata"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608,
          "pattern": ".*\\S.*"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "required": [
            "desktop_article_id"
          ],
          "properties": {
            "desktop_article_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "IdProjection": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "additionalProperties": true
    },
    "CreateArticleResponse": {
      "type": "object",
      "required": [
        "article",
        "revision"
      ],
      "properties": {
        "article": {
          "$ref": "#/$defs/IdProjection"
        },
        "revision": {
          "$ref": "#/$defs/IdProjection"
        }
      },
      "additionalProperties": true
    },
    "CreateRevisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown",
        "parent_revision_id"
      ],
      "properties": {
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608,
          "pattern": ".*\\S.*"
        },
        "parent_revision_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "CreateRevisionResponse": {
      "$ref": "#/$defs/IdProjection"
    },
    "ArticleListItemProjection": {
      "type": "object",
      "required": [
        "id",
        "metadata_json"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "metadata_json": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "additionalProperties": true
    },
    "ListArticlesResponse": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArticleListItemProjection"
      }
    },
    "ArticleRevisionProjection": {
      "type": "object",
      "required": [
        "id",
        "number",
        "markdown",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608,
          "pattern": ".*\\S.*"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        }
      },
      "additionalProperties": true
    },
    "ArticleDetailResponse": {
      "type": "object",
      "required": [
        "latest_revision"
      ],
      "properties": {
        "latest_revision": {
          "$ref": "#/$defs/ArticleRevisionProjection"
        }
      },
      "additionalProperties": true
    },
    "WorkflowProjection": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "additionalProperties": true
    },
    "ListWorkflowsResponse": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/WorkflowProjection"
      }
    },
    "OptionalWorkflowNodeId": {
      "enum": [
        "research",
        "outline",
        "natural-style",
        "review",
        "visual"
      ]
    },
    "WorkflowNodeId": {
      "enum": [
        "research",
        "outline",
        "draft",
        "natural-style",
        "review",
        "risk",
        "visual"
      ]
    },
    "WorkflowSkillInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "instructions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": ".*\\S.*"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000,
          "pattern": ".*\\S.*"
        }
      }
    },
    "WorkflowAgentInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "node_id",
        "prompt",
        "skills"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": ".*\\S.*"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": ".*\\S.*"
        },
        "node_id": {
          "$ref": "#/$defs/WorkflowNodeId"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000,
          "pattern": ".*\\S.*"
        },
        "skills": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/WorkflowSkillInstruction"
          }
        }
      }
    },
    "VisualAssetInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alt",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": ".*\\S.*"
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "VisualCompositionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_count",
        "assets"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "auto",
            "fixed"
          ]
        },
        "target_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "assets": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/VisualAssetInstruction"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "target_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "auto"
              }
            }
          },
          "then": {
            "properties": {
              "target_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "target_count": {
                "minimum": 1,
                "maximum": 6
              }
            }
          }
        }
      ]
    },
    "StartRunPolicyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_content_approval",
        "allow_remote_publish",
        "disabled_optional_node_ids",
        "visual_composition"
      ],
      "properties": {
        "require_content_approval": {
          "type": "boolean"
        },
        "max_revision_loops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_wall_clock_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "allow_remote_publish": {
          "const": false
        },
        "disabled_optional_node_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OptionalWorkflowNodeId"
          }
        },
        "agent_instructions": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/WorkflowAgentInstruction"
          }
        },
        "visual_composition": {
          "$ref": "#/$defs/VisualCompositionRequest"
        }
      }
    },
    "StartRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "article_id",
        "revision_id",
        "topic",
        "policy"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "article_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        },
        "policy": {
          "$ref": "#/$defs/StartRunPolicyRequest"
        }
      }
    },
    "WorkflowRunResponse": {
      "type": "object",
      "required": [
        "id",
        "input_revision_id",
        "output_revision_id",
        "status",
        "state_json",
        "error"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "input_revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "output_revision_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "state_json": {
          "$ref": "#/$defs/JsonObject"
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "RuntimeEventProjection": {
      "type": "object",
      "required": [
        "id",
        "event_type",
        "payload_json",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "payload_json": {
          "$ref": "#/$defs/JsonObject"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": true
    },
    "ActiveRunResponse": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "run",
            "events"
          ],
          "properties": {
            "run": {
              "$ref": "#/$defs/WorkflowRunResponse"
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RuntimeEventProjection"
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "CompleteDemoRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "topic",
        "source_markdown",
        "platforms",
        "disabled_optional_node_ids"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        },
        "source_markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608,
          "pattern": ".*\\S.*"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "csdn",
              "wechat",
              "toutiao"
            ]
          }
        },
        "disabled_optional_node_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "research",
              "outline",
              "natural-style",
              "review",
              "visual"
            ]
          }
        }
      }
    },
    "RunStatusProjection": {
      "type": "object",
      "required": [
        "status",
        "state_json"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "state_json": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "additionalProperties": true
    },
    "PlanStatusProjection": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "additionalProperties": true
    },
    "ReceiptProjection": {
      "type": "object",
      "required": [
        "status",
        "remote_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "remote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": true
    },
    "ContentPackageProjection": {
      "type": "object",
      "required": [
        "assets"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      },
      "additionalProperties": true
    },
    "CompleteDemoResponse": {
      "type": "object",
      "required": [
        "run",
        "plan",
        "receipts",
        "content_package"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/RunStatusProjection"
        },
        "plan": {
          "$ref": "#/$defs/PlanStatusProjection"
        },
        "receipts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ReceiptProjection"
          }
        },
        "content_package": {
          "$ref": "#/$defs/ContentPackageProjection"
        }
      },
      "additionalProperties": true
    },
    "PublishTargetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "account_ref"
      ],
      "properties": {
        "platform": {
          "enum": [
            "csdn",
            "wechat",
            "toutiao"
          ]
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": ".*\\S.*"
        },
        "connection_profile_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "simulate_outcome": {
          "enum": [
            "success",
            "unknown",
            "unknown_then_success",
            "retryable_failure",
            "terminal_failure"
          ]
        }
      }
    },
    "CreatePublishPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "targets"
      ],
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PublishTargetRequest"
          }
        },
        "selected_asset_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "ApprovePublishPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "comment"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": ".*\\S.*"
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": ".*\\S.*"
        }
      }
    },
    "EmptyRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "PublishPlanProjection": {
      "type": "object",
      "required": [
        "id",
        "revision_id",
        "status",
        "approval_status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "queued",
            "running",
            "completed",
            "needs_attention"
          ]
        },
        "approval_status": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": true
    },
    "PublishVariantProjection": {
      "type": "object",
      "required": [
        "id",
        "platform",
        "account_ref",
        "title",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "platform": {
          "enum": [
            "csdn",
            "wechat",
            "toutiao"
          ]
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": ".*\\S.*"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        }
      },
      "additionalProperties": true
    },
    "PublishJobProjection": {
      "type": "object",
      "required": [
        "id",
        "plan_id",
        "variant_id",
        "platform",
        "account_ref",
        "operation",
        "idempotency_key",
        "payload_hash",
        "state",
        "remote_id",
        "last_error",
        "reconcile_required",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "variant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "platform": {
          "enum": [
            "csdn",
            "wechat",
            "toutiao"
          ]
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": ".*\\S.*"
        },
        "operation": {
          "enum": [
            "dry_run",
            "reconcile"
          ]
        },
        "idempotency_key": {
          "$ref": "#/$defs/ContentHash"
        },
        "payload_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "state": {
          "enum": [
            "pending",
            "in_progress",
            "succeeded",
            "failed_retryable",
            "failed_terminal",
            "unknown",
            "reconciling",
            "cancelled"
          ]
        },
        "remote_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
