{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openpublisher.dev/v1/content-package-manifest.schema.json",
  "title": "ContentPackageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceApp",
    "articleRevisionId",
    "entries",
    "platformVariantIds",
    "packageHash",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
    },
    "sourceApp": {
      "description": "Human-readable application identifier that produced the package.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "articleRevisionId": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "path",
          "mediaType",
          "contentHash",
          "sizeBytes"
        ],
        "properties": {
          "artifactId": {
            "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
          },
          "path": {
            "description": "Canonical NFC POSIX relative path. Backslashes, drive letters, traversal segments, control characters, and Windows-reserved characters are forbidden.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[<>:\"|?*\\u0000-\\u001F\\u007F]).+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "contentHash": {
            "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Sha256"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "platformVariantIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
      }
    },
    "packageHash": {
      "description": "SHA-256 of the RFC 8785 canonical JSON bytes of this manifest with packageHash omitted, entries sorted by NFC path, and platformVariantIds sorted lexicographically. Entry contentHash values bind the referenced file bytes, and importers must verify every entry size and digest.",
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Sha256"
    },
    "createdAt": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Timestamp"
    }
  }
}
