{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openpublisher.dev/v1/skill-manifest.schema.json",
  "title": "SkillManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "license",
    "runtime",
    "capabilities",
    "inputArtifactTypes",
    "outputArtifactTypes",
    "permissions",
    "declaration",
    "configSchema",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiVersion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "declarative",
            "python",
            "typescript",
            "external"
          ]
        },
        "apiVersion": {
          "const": "1.0"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
      }
    },
    "inputArtifactTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "outputArtifactTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelAccess",
        "imageGeneration",
        "browserRead",
        "platformWrites",
        "filesystem",
        "networkServices"
      ],
      "properties": {
        "modelAccess": {
          "type": "boolean"
        },
        "imageGeneration": {
          "type": "boolean"
        },
        "browserRead": {
          "type": "boolean"
        },
        "platformWrites": {
          "const": false
        },
        "filesystem": {
          "enum": [
            "none",
            "workspace-read",
            "workspace-write"
          ]
        },
        "networkServices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
          }
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "instructions",
        "guardrails"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "guardrails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "configSchema": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "first-party",
            "third-party"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "const": "declarative"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "not": {
              "required": [
                "entrypoint"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "runtime": {
            "required": [
              "entrypoint"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "third-party"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "url": {
                "pattern": "^https://"
              }
            },
            "required": [
              "url",
              "commit",
              "license"
            ]
          }
        }
      }
    }
  ]
}
