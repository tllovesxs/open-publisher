{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openpublisher.dev/v1/workflow-definition.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "nodes",
    "edges",
    "entryNodeIds",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "inputArtifactTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "outputArtifactTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "entryNodeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParallel",
        "requiresApprovalBeforePublish"
      ],
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "requiresApprovalBeforePublish": {
          "type": "boolean"
        },
        "failFast": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "handler"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "agent",
            "skill",
            "tool",
            "human",
            "condition",
            "fanout",
            "join"
          ]
        },
        "handler": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "optional": {
          "type": "boolean"
        },
        "concurrencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/JsonValue"
          }
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
        },
        "to": {
          "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
