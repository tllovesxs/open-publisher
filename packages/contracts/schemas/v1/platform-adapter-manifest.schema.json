{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openpublisher.dev/v1/platform-adapter-manifest.schema.json",
  "title": "PlatformAdapterManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "platform",
    "name",
    "version",
    "license",
    "transport",
    "supportedOperations",
    "requiredAuthMethods",
    "capabilities",
    "permissions",
    "safeDefaults"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
    },
    "platform": {
      "$ref": "https://schemas.openpublisher.dev/v1/common.schema.json#/$defs/Identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "transport": {
      "enum": [
        "browser_extension",
        "api",
        "manual"
      ]
    },
    "supportedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "probe",
          "prepare_draft",
          "save_draft",
          "publish",
          "reconcile"
        ]
      }
    },
    "requiredAuthMethods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "api_key",
          "oauth",
          "browser_session",
          "custom"
        ]
      }
    },
    "editorUrlPatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportsMarkdown",
        "supportsHtml",
        "supportsDrafts",
        "supportsScheduling"
      ],
      "properties": {
        "supportsMarkdown": {
          "type": "boolean"
        },
        "supportsHtml": {
          "type": "boolean"
        },
        "supportsDrafts": {
          "type": "boolean"
        },
        "supportsScheduling": {
          "type": "boolean"
        },
        "maxTitleLength": {
          "type": "integer",
          "minimum": 1
        },
        "maxTagCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "taskSchemaRef": {
      "type": "string",
      "format": "uri-reference",
      "maxLength": 2000
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPatterns",
        "cookieAccess"
      ],
      "properties": {
        "hostPatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "cookieAccess": {
          "type": "boolean"
        }
      }
    },
    "safeDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMode",
        "finalPublishRequiresUser",
        "exportsCookies"
      ],
      "properties": {
        "defaultMode": {
          "enum": [
            "save_draft",
            "publish"
          ]
        },
        "finalPublishRequiresUser": {
          "type": "boolean"
        },
        "exportsCookies": {
          "type": "boolean"
        }
      }
    }
  }
}
