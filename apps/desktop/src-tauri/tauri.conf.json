{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Publisher",
  "version": "0.1.0",
  "identifier": "io.openpublisher.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:bundle-inputs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Publisher · 砚台工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地优先智能写作与多平台发布工作台",
    "longDescription": "在本地完成 AI 辅助写作、证据与风险审核，并通过确定性任务队列发布到多个内容平台。",
    "createUpdaterArtifacts": false
  }
}
